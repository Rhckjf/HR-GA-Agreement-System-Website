{
  "buildCommand": "cd app/frontend && npm install && npm run build",
  "outputDirectory": "app/frontend/build",
  "env": {
    "REACT_APP_BACKEND_URL": "@REACT_APP_BACKEND_URL"
  },
  "routes": [
    {
      "src": "^/api/(.*)",
      "dest": "https://your-backend-url.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
